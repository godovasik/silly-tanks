{
    "manifest_version": 3,
    "name": "Silly Tanks",
    "version": "0.7.4",
    "description": "QoL for Tanki Online: quick equipment panel, augments above tanks in battle",
    "content_scripts": [
        {
            "matches": [
                "*://*.tankionline.com/*"
            ],
            "js": [
                "bootstrap.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "matches": [
                "*://*.tankionline.com/*"
            ],
            "resources": [
                "devices.js",
                "garage.js",
                "labels.js",
                "packets.js",
                "panel.js",
                "settings.js"
            ]
        }
    ]
}
