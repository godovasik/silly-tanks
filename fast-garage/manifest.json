{
    "manifest_version": 3,
    "name": "Fast Garage",
    "version": "0.5.3",
    "description": "Quick equipment changes for Tanki Online without the garage UI",
    "content_scripts": [
        {
            "matches": [
                "*://*.tankionline.com/*"
            ],
            "js": [
                "bootstrap.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "matches": [
                "*://*.tankionline.com/*"
            ],
            "resources": [
                "devices.js",
                "garage.js",
                "panel.js"
            ]
        }
    ]
}
